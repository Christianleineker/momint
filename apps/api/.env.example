DATABASE_URL="postgresql://momint:momint@localhost:5433/momint"
JWT_SECRET="troque-este-segredo-em-producao"
# Gere um segredo aleatorio de pelo menos 32 caracteres para proteger os codigos 2FA.
# OTP_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
DATA_MODE="mock"
PORT=4000
MOMINT_HOJE="2026-09-30"

# arquivo: salva pre-visualizacoes em apps/api/.mailbox, sem enviar e-mails.
# smtp: envia pelo provedor configurado. Em producao use smtp e URL_WEB HTTPS.
URL_WEB="http://localhost:3000"
EMAIL_TRANSPORT="arquivo"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="francisco.fta9@gmail.com"
SMTP_FROM="francisco.fta9@gmail.com"
# Configure a senha de aplicativo em .env, nunca no repositorio.
SMTP_PASS=""
