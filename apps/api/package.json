{
  "name": "@momint/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:setup": "prisma migrate dev --name init --skip-seed && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "admin:preparar": "tsx scripts/preparar-admin.ts",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nodemailer": "^10.0.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
